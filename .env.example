# Aviator Intelligence - example local configuration.
# Copy to `.env` (which is git-ignored) only if you need to change a default.
# This file must never contain secrets. The application needs no credentials,
# API keys, betting-account details, cookies or tokens, and must not be given any.

# Runtime mode: development | test | production
NODE_ENV=development

# Host the local API binds to. Loopback only by default.
# Binding to a non-loopback address is refused unless AVIATOR_ALLOW_REMOTE_BIND=true.
API_HOST=127.0.0.1
API_PORT=4317
AVIATOR_ALLOW_REMOTE_BIND=false

# SQLite database file. Relative paths are resolved against the repository root.
# The default location (data/) is git-ignored.
AVIATOR_DB_PATH=data/aviator.sqlite

# ISO 4217 currency used for virtual (simulated) amounts. Supported: NGN, USD, GBP, EUR.
AVIATOR_CURRENCY=NGN
